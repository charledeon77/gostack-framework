APP_NAME="{{PROJECT_NAME}}"
APP_ENV=local
APP_KEY={{APP_KEY}}
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost:8080

# ─── Database Configuration ──────────────────────────────────
DB_DRIVER={{DB_DRIVER}}
DB_DSN="{{DB_DSN}}"

# ─── Session & Security ──────────────────────────────────────
SESSION_LIFETIME=120
SESSION_COOKIE={{PROJECT_NAME}}_session
CSRF_COOKIE=XSRF-TOKEN

